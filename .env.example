# Host path variables for docker compose
# CCTV_DATA_PATH is OPTIONAL — only needed when running the detection pipeline.
# The API auto-seeds demo events on first boot so the dashboard works without CCTV footage.
# 
# To use detection: set CCTV_DATA_PATH to absolute path of your CCTV footage folder (no spaces)
# Example: CCTV_DATA_PATH=/home/user/cctv-footage
CCTV_DATA_PATH=

# SALES_CSV_PATH: path to Brigade_Bangalore_10_April_26.csv (optional — fallback data built in)
SALES_CSV_PATH=../Brigade_Bangalore_10_April_26.csv
